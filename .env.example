APP_NAME="Adilisha STEM Labs"
APP_ENV=local
APP_KEY=base64:lGzX/AP1gjlTM7cIauIYTbTLVxHocGgVAoIie6lrStA=
APP_DEBUG=true
APP_URL=http://localhost
APP_ADMIN_URL=https://admin.adilishastemlabs.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uat_stem
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (use "log" for local dev, "smtp" for VPS with Namecheap Private Email)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.privateemail.com
MAIL_PORT=587
MAIL_USERNAME=support@adilishastemlabs.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@adilishastemlabs.com
MAIL_FROM_NAME="Adilisha Support"
MAIL_ADMIN_ALERT_ADDRESS=support@adilishastemlabs.com

# Soscom SMS (paste live key on the server .env only — never commit secrets)
SOSCOM_SMS_ENABLED=true
SOSCOM_SMS_BASE_URL=https://sms.soscom.co.tz/api/v1
SOSCOM_SMS_API_KEY=
SOSCOM_SMS_DEFAULT_SENDER=ADILISHA
SOSCOM_SMS_ALLOWED_SENDERS=ADILISHA,ADILISHAXR,STEMLABS

# Subscriptions / Snippe (keep secrets server-side only)
SUBSCRIPTION_PAYMENTS_ENABLED=false
SUBSCRIPTION_RENEWAL_REMINDER_DAYS=3
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_PROFILE_ID=
SNIPPE_CURRENCY=TZS
SNIPPE_SESSION_EXPIRES_IN=3600
SNIPPE_WEBHOOK_TOLERANCE_SECONDS=300
SNIPPE_HTTP_TIMEOUT=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Africa/Nairobi
